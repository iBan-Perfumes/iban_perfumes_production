# Production site URL (no trailing slash) — required for canonicals, sitemap, OG
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Display phone (tel: links, footer, contact page)
NEXT_PUBLIC_PHONE_NUMBER=+91 9876543210

# WhatsApp for Buy Now, floating button, and site icons (country code, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Social profile URLs (full https links)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-profile
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page

# Search engine indexing: "true" allows crawl/index; empty or "false" blocks it
ALLOW_INDEXING=false

# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Admin panel credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string
